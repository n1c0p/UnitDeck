# unitdeck: name=SMB share mounted with gio; scope=user
# gio needs a user session with D-Bus: this template is for user services only.
# The credentials file (relative to your home) holds the answers to gio's prompts,
# one per line: user name, domain (may be empty) and password.
[Unit]
Description=Mount SMB share
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c '/usr/bin/gio mount "smb://{USER}@{SERVER}/{SHARE}" < %h/{CREDENTIALS_FILE}'
ExecStop=/usr/bin/gio mount -u "smb://{USER}@{SERVER}/{SHARE}"

[Install]
WantedBy=default.target
