# unitdeck: name=Long-running service (Restart=on-failure); scope=both
[Unit]
Description={DESCRIPTION}
After={AFTER}
Wants={WANTS}

[Service]
Type=simple
ExecStart={EXEC_START}
ExecStop={EXEC_STOP}
Restart=on-failure
RestartSec=5
User={USER}
Group={GROUP}

[Install]
WantedBy={WANTED_BY}
